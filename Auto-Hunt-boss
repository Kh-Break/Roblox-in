/*
====================================================================
PANDUAN PENGGUNAAN & INSTALASI
====================================================================

1. Instal AHK
Buka Situs Resmi AHK:
- Buka browser (Chrome/Edge/Firefox) dan kunjungi situs resminya di autohotkey.com.
- Download AutoHotkey: Klik tombol Download, lalu pilih Download v terbaru, disini aku pakek v 1.1 (Deprecated/Legacy). 
  (Sangat penting memilih v1.1, karena struktur kodingan yang kamu gunakan di atas dibuat khusus untuk AHK versi 1.1).
Jalankan Installer:
- Buka file installer yang baru saja diunduh (misalnya AutoHotkey_1.1.37.02_setup.exe).
- Pilih opsi Express Installation.
- Tunggu proses instalasi selesai, lalu klik Exit.

2. Buat Skrip
Buka Desktop / Folder Pilihan:
- Masuk ke folder tempat kamu ingin menyimpan file skrip ini.
Buat File Baru:
- Klik kanan pada area kosong di folder/desktop.
- Pilih New -> AutoHotkey Script.
- Beri nama file tersebut, contohnya: AHunt.ahk (atau WaterBoss.ahk)
Edit Skrip:
- Klik kanan pada file skrip yang baru dibuat.
- Pilih Edit Script (file akan terbuka di Notepad).
- Hapus semua isi teks standar yang ada di Notepad tersebut.
- Copy & Paste seluruh kodingan AHK ke dalam Notepad (di bawah komentar ini).
- Simpan / Save (Ctrl + S).

3. Running on Game
- Buka Evomon, siapkan Tarragon dengan skill Seed Bomb dan FW2.
- Klik 2 kali icon AHK script yang sudah dibuat.
- Masuk ke game, arahkan karakter dekat boss dengan kursor di area bawah karakter.
- Tekan F5 dan F6 untuk mengaktifkan kodingan. Kalau mau dimatikan tekan F6, dan untuk mematikan penuh tekan F5 2x.

4. Catatan Boss:
- Water Boss:
  * Gunakan Tarragon dengan skill Seed Bomb dan FW2.
  * Nyalakan auto.
- Grass Boss:
  * Gunakan Magmazor dengan skill Intimidation.
- Catatan Penting:
  * Harus max level 210 untuk Tarragon dan Magmazor.

Good luck!
====================================================================
*/

; --- KODINGAN AHK KAMU DIMULAI DI BAWAH INI ---

; ==============================================================================
; DIREKTIF & INISIALISASI VARIABEL
; ==============================================================================
#NoEnv
#SingleInstance Force
SendMode Input
SetBatchLines -1
 
; ------------------------------------------------------------------------------
; PENGATURAN INTERVAL WAKTU (Dalam Milidetik)
; 1500 detik = 1,500 milidetik (ms)
; Ubah angka ini jika ingin mengganti interval waktu perulangan!
; Contoh: 1000 = 1 detik, 60000 = 1 menit, 1500000 = 25 menit (1500 detik)
; ------------------------------------------------------------------------------
IntervalWaktu := 1500

; Variabel Status Global
MenuOn := false
IsPaused := false

StatusAutoAksi := "OFF"
PrevAutoAksi := "OFF"

; Variabel Timestamp untuk Deteksi Double-Press
F5PressTime := 0

return ; Akhir dari Auto-Execute Section

; ==============================================================================
; HOTKEY +F5 / F5 (ON / OFF / EXIT DENGAN DOUBLE-PRESS)
; ==============================================================================
+F5::
F5::
    if (MenuOn = false) 
    {
        StatusAutoAksi := "OFF"
        IsPaused := false
        
        MenuOn := true
        F5PressTime := A_TickCount
        Gosub, UpdateToolTip
        return
    }
    
    if (MenuOn = true) 
    {
        if (A_TickCount - F5PressTime < 400) 
        {
            SetTimer, TimerAutoAksi, Off
            ToolTip
            ExitApp
        } 
        else 
        {
            SetTimer, TimerAutoAksi, Off
            
            StatusAutoAksi := "OFF"
            IsPaused := false
            MenuOn := false
            ToolTip
        }
        F5PressTime := A_TickCount
    }
return

; ==============================================================================
; HOTKEY ~Ctrl / ~+Ctrl (PAUSE / RESUME)
; ==============================================================================
~+Ctrl::
~Ctrl::
    Gosub, PauseToggle
return

PauseToggle:
    if (MenuOn = false)
        return
        
    IsPaused := !IsPaused
    
    if (IsPaused) 
    {
        PrevAutoAksi := StatusAutoAksi
        
        SetTimer, TimerAutoAksi, Off
        
        if (StatusAutoAksi = "ON") 
            StatusAutoAksi := "PAUSED"
            
        SoundBeep, 400, 200
    } 
    else 
    {
        StatusAutoAksi := PrevAutoAksi
        
        if (StatusAutoAksi = "ON") 
            SetTimer, TimerAutoAksi, %IntervalWaktu%
        
        SoundBeep, 800, 80
        SoundBeep, 1000, 80
    }
    
    Gosub, UpdateToolTip
return

; ==============================================================================
; HOTKEY TOGGLE AUTO SPASI + E + KLIK KIRI (Tekan F6)
; ==============================================================================
F6::
    if (MenuOn = false || IsPaused)
        return

    if (StatusAutoAksi = "OFF") 
    {
        StatusAutoAksi := "ON"
        
        ; Jalankan sekali langsung saat diaktifkan
        Gosub, TimerAutoAksi
        
        ; Set timer perulangan sesuai variabel IntervalWaktu
        SetTimer, TimerAutoAksi, %IntervalWaktu%
        SoundBeep, 900, 100
    } 
    else 
    {
        StatusAutoAksi := "OFF"
        SetTimer, TimerAutoAksi, Off
        SoundBeep, 500, 100
    }

    Gosub, UpdateToolTip
return

; ==============================================================================
; TIMER CALLBACK (Mengeksekusi Spasi, E, dan Klik Kiri)
; ==============================================================================
TimerAutoAksi:
    if (IsPaused) 
    {
        SetTimer, TimerAutoAksi, Off
        return
    }
    
    ; Eksekusi urutan tombol
    SendInput {Space}
    Sleep, 100
    SendInput e
    Sleep, 100
    Click
return

; ==============================================================================
; SUBROUTINE UPDATE TOOLTIP
; ==============================================================================
UpdateToolTip:
    if (MenuOn = false) 
    {
        ToolTip
        return
    }
    
    ; Kalkulasi teks durasi interval untuk tampilan ToolTip (dalam detik)
    DetikInterval := IntervalWaktu / 1000
    
    if (IsPaused) 
    {
        menuText := "===== MACRO STATUS [PAUSED] =====`n"
    } 
    else 
    {
        menuText := "===== MACRO STATUS (F5) =====`n"
    }
    
    menuText .= "--------------------------------`n"
    menuText .= "[F5]      Menu/Exit   : ON`n"
    menuText .= "[F6]      Spasi+E+Klik: " . StatusAutoAksi . "`n"
    menuText .= "--------------------------------`n"
    menuText .= "Interval  : " . DetikInterval . " Detik`n"
    menuText .= "--------------------------------`n"
    menuText .= "* [Ctrl] Pause/Resume  [F5] Off  [F5 x2] Exit"
    
    ToolTip, %menuText%, 10, 120
return
